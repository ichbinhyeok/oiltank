<section class="fuel-soft"><div class="v2-shell fuel-section"><div class="fuel-section-head"><div><p class="v2-eyebrow">Before the next delivery</p><h2>Buying oil?<br>Work through the numbers.</h2></div><a href="/heating-oil-guides/">All heating oil guides ↗</a></div><div class="fuel-guide-grid">@for(var guide : owner.buriedoiltank.heating.FuelGuideCatalog.ALL.stream().filter(g -> java.util.List.of("100-gallons-heating-oil", "cash-heating-oil", "how-long-does-heating-oil-last", "heating-oil-vs-propane").contains(g.slug())).toList())<article><p class="v2-eyebrow">${guide.category()}</p><h3><a href="${guide.path()}">${guide.title()}</a></h3><p>${guide.description()}</p></article>@endfor</div></div></section>
