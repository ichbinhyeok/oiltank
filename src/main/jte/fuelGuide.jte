@import owner.buriedoiltank.pages.FuelPageService.GuidePage
@param GuidePage page
@template.layout.page(meta = page.meta(), activeNav = "guides", content = @`
<article class="fuel-page fuel-guide" data-fuel-guide="${page.guide().slug()}">
<header class="fuel-heading"><div class="v2-shell"><nav class="v2-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/heating-oil-guides/">Heating oil guides</a><span>/</span><span>${page.guide().category()}</span></nav><p class="v2-eyebrow">${page.guide().category()} · Reviewed November 18, 2026</p><h1>${page.guide().title()}</h1><p class="fuel-intro">${page.guide().description()}</p><div class="fuel-answer"><h2>The quick answer</h2><p>${page.guide().answer()}</p></div><nav class="fuel-jump" aria-label="On this page">@for(var section : page.guide().sections())<a href="#${section.id()}">${section.heading()}</a>@endfor<a href="#sources">Sources</a></nav></div></header>
<div class="v2-shell fuel-article-layout"><div class="fuel-article-body">
@if(page.guide().tool().equals("order"))
<section class="fuel-section" id="order-budget"><p class="v2-eyebrow">Dated benchmark · Editable quote</p><h2>${page.guide().gallons()}-gallon delivery budget</h2><p>The U.S. EIA residential benchmark observed ${page.snapshot().observedOn().toString()} was $${page.price()} per gallon, excluding taxes. At that rate, ${page.guide().gallons()} gallons has a fuel subtotal of <strong>${page.cost()}</strong>. Released ${page.snapshot().releasedOn().toString()}; next scheduled release ${page.snapshot().nextScheduledRelease().toString()}.</p>
@if(page.overdue())<p class="fuel-notice">A newer release may be available. These are the last verified figures retained here; check EIA for the latest observation.</p>@endif
<form class="fuel-budget-form" data-budget-form data-page-id="fuel-guide:${page.guide().slug()}"><label>Gallons<input name="gallons" type="number" min="1" max="10000" step="1" value="${page.guide().gallons()}" required></label><label>Your quote ($/gal)<input name="price" type="number" min="0.001" max="100" step="0.001" value="${page.price()}" required></label><label>Quoted fuel tax (%)<input name="tax" type="number" min="0" max="100" step="0.01" value="0" required></label><label>Quoted fees ($)<input name="fees" type="number" min="0" max="10000" step="0.01" value="0" required></label><button class="v2-button" type="submit">Calculate delivered total</button><output data-budget-result aria-live="polite">${page.cost()} fuel subtotal before taxes and fees.</output></form><p><a href="#state-costs">Compare the same order in 21 states ↓</a></p></section>
@endif
@if(page.guide().tool().equals("runtime"))
<section class="fuel-section" id="days-calculator"><h2>Calculate planning days left</h2><form class="fuel-budget-form" data-runtime-form data-page-id="fuel-guide:${page.guide().slug()}"><label>Gallons remaining<input name="remaining" type="number" min="0" max="10000" step="0.1" value="100" required></label><label>Planning reserve (gal)<input name="reserve" type="number" min="0" max="10000" step="0.1" value="10" required></label><label>Assumed gallons/day<input name="daily" type="number" min="0.01" max="1000" step="0.01" value="3" required></label><button class="v2-button" type="submit">Estimate days left</button><output data-runtime-result aria-live="polite">100 gallons − 10 gallons reserve, at 3 gallons/day = 30.0 planning days.</output></form><p>Formula: max(0, remaining − reserve) ÷ daily use. This does not predict the date your system will stop or set a safe operating level.</p></section>
@endif
@if(page.guide().tool().equals("heat"))
<section class="fuel-section" id="heat-calculator"><h2>Compare fuel cost per useful heat</h2><form class="fuel-budget-form" data-heat-form data-page-id="fuel-guide:${page.guide().slug()}"><label>Oil quote ($/gal)<input name="oilPrice" type="number" min="0.001" max="100" step="0.001" value="5" required></label><label>Oil efficiency (%)<input name="oilEfficiency" type="number" min="1" max="100" step="0.1" value="85" required></label><label>Propane quote ($/gal)<input name="propanePrice" type="number" min="0.001" max="100" step="0.001" value="3" required></label><label>Propane efficiency (%)<input name="propaneEfficiency" type="number" min="1" max="100" step="0.1" value="90" required></label><button class="v2-button" type="submit">Compare useful heat</button><output data-heat-result aria-live="polite">Example: oil $42.47 and propane $36.45 per useful million Btu. Break-even propane price: $3.496/gallon.</output></form><p>Defaults are an illustrative scenario. The calculation uses 138,500 Btu/gallon oil and 91,452 Btu/gallon propane. Taxes, delivery fees, tank rental and equipment conversion costs are excluded; compare those separately.</p></section>
@endif
@for(var section : page.guide().sections())
<section class="fuel-section" id="${section.id()}"><h2>${section.heading()}</h2>@for(var paragraph : section.paragraphs())<p>${paragraph}</p>@endfor
@if(!section.bullets().isEmpty())<ul>@for(var bullet : section.bullets())<li>${bullet}</li>@endfor</ul>@endif
@if(!section.columns().isEmpty())<div class="table-wrap"><table><caption>${section.heading()}</caption><thead><tr>@for(var column : section.columns())<th scope="col">${column}</th>@endfor</tr></thead><tbody>@for(var row : section.rows())<tr>@for(int i=0; i<row.size(); i++)@if(i==0)<th scope="row">${row.get(i)}</th>@else<td>${row.get(i)}</td>@endif@endfor</tr>@endfor</tbody></table></div>@endif</section>
@endfor
@if(page.guide().tool().equals("order"))<section class="fuel-section" id="state-costs"><h2>${page.guide().gallons()} gallons at each state's survey price</h2><p>Observed ${page.snapshot().observedOn().toString()}; fuel subtotals only, before taxes and fees. Each state page includes its price history and editable delivery budget.</p><div class="table-wrap"><table><caption>Same quantity, same observation date</caption><thead><tr><th scope="col">State</th><th scope="col">$/gallon</th><th scope="col">${page.guide().gallons()} gallons</th></tr></thead><tbody>@for(var row : page.states())<tr><th scope="row"><a href="${row.path()}">${row.area().name()}</a></th><td>$${row.price()}</td><td>${owner.buriedoiltank.pages.FuelPageService.money(row.price().multiply(java.math.BigDecimal.valueOf(page.guide().gallons())) )}</td></tr>@endfor</tbody></table></div></section>@endif
<section class="fuel-section fuel-source" id="sources"><h2>Sources and calculation notes</h2><p>Editorial review: November 18, 2026. Supplier examples illustrate published terms; confirm the current offer directly. All worked-price and consumption scenarios are labeled assumptions. Price data, when shown, has its own observation and release date.</p><ul>@for(var source : page.guide().sources())<li><a href="${source.url()}" target="_blank" rel="noopener noreferrer">${source.title()} ↗</a></li>@endfor</ul><p>Prepared by Oil Tank Route. We publish independent planning tools and do not accept fuel orders.</p><button type="button" class="v2-button" data-print-chart>Print this guide</button></section>
</div><aside class="fuel-guide-aside"><p class="v2-eyebrow">Next useful step</p><nav aria-label="Related guides and tools">@for(var related : page.guide().related())<a href="${related.url()}">${related.title()} ↗</a>@endfor<a href="/heating-oil-guides/">All buying guides ↗</a></nav></aside></div>
</article>
`)
