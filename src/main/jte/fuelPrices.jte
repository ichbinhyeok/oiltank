@import owner.buriedoiltank.pages.FuelPageService.PricePage
@param PricePage page
@template.layout.page(meta = page.meta(), activeNav = "prices", content = @`
<div class="fuel-page" data-price-page="${page.area().id()}">
<header class="fuel-heading"><div class="v2-shell">
    <nav class="v2-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/heating-oil-prices/">Heating oil prices</a>@if (!page.area().id().equals("us"))<span>/</span><span>${page.area().name()}</span>@endif</nav>
    <p class="v2-eyebrow">Residential heating oil · EIA weekly survey</p><h1>${page.heading()}</h1><p class="fuel-intro">${page.intro()}</p>
    <div class="fuel-price-line"><p><strong>$${page.price()}</strong><span>per US gallon</span></p><p><b>${page.changeLabel()}</b><span>${page.weekPercent()}% since the previous observation</span></p></div>
    <p class="fuel-date">Observed <time>${page.snapshot().observedOn().toString()}</time> · Released ${page.snapshot().releasedOn().toString()} · Next scheduled release ${page.snapshot().nextScheduledRelease().toString()}</p>
    @if (page.overdue())<p class="fuel-notice" role="status">A newer release may be available. These are the last verified figures retained here. Check EIA before treating them as current.</p>@endif
    <nav class="fuel-jump" aria-label="On this page"><a href="#price-history">Price history</a><a href="#delivery-budget">Delivery budget</a><a href="#state-prices">By state</a><a href="#quote-check">Compare quotes</a></nav>
</div></header>
<section class="v2-shell fuel-section" id="price-history"><div class="fuel-section-head"><div><p class="v2-eyebrow">Recent observations</p><h2>${page.area().name()} price trend</h2></div><a href="/heating-oil-prices/data.csv">Download source data CSV ↓</a></div>
    <figure class="fuel-chart"><svg viewBox="0 0 700 180" role="img" aria-labelledby="price-chart-title"><title id="price-chart-title">${page.area().name()} heating oil prices from ${page.history().get(0).date().toString()} through ${page.snapshot().observedOn().toString()}. Read the exact prices in the table below.</title><path d="M15 155H685 M15 92H685 M15 30H685" class="fuel-grid"/><polyline points="${page.chartPoints()}"/></svg><figcaption>Vertical scale follows the observed price range; it does not start at zero. Exact figures appear below.</figcaption></figure>
    <div class="table-wrap"><table><caption>Price history and a 150-gallon benchmark subtotal</caption><thead><tr><th>Observation</th><th scope="col">$/gallon</th><th scope="col">150 gallons</th></tr></thead><tbody>@for (var row : page.history())<tr><th scope="row">${row.date().toString()}</th><td>$${row.price()}</td><td>${row.cost150()}</td></tr>@endfor</tbody></table></div>
</section>
<section class="fuel-soft" id="delivery-budget"><div class="v2-shell fuel-section"><div class="fuel-section-head"><div><p class="v2-eyebrow">Plan the amount</p><h2>What could a delivery cost?</h2></div><p>These amounts multiply the dated survey price by gallons. Taxes and fees are separate; your supplier's quote sets your actual price.</p></div>
    <dl class="fuel-budget-strip">@for (var row : page.budgets())<div><dt>${row.gallons()} gallons</dt><dd>${row.cost()}</dd></div>@endfor</dl>
    <form class="fuel-budget-form" data-budget-form data-page-id="prices:${page.area().id()}"><label>Gallons<input name="gallons" type="number" min="1" max="10000" step="1" value="150" required></label><label>Price per gallon ($)<input name="price" type="number" min="0.001" max="100" step="0.001" value="${page.price()}" required></label><label>Quoted tax (%)<input name="tax" type="number" min="0" max="100" step="0.01" value="0" required></label><label>Quoted fees ($)<input name="fees" type="number" min="0" max="10000" step="0.01" value="0" required></label><button class="v2-button" type="submit">Calculate budget</button><output aria-live="polite" data-budget-result>150 gallons at the survey price: ${page.budgets().get(1).cost()} before taxes and fees.</output></form>
    <p><a href="/oil-tank-gauge-calculator/">First, check the gallons in your tank ↗</a> · <a href="/how-much-heating-oil-do-i-need/">Estimate order space ↗</a> · @if(page.hasSupplier())<a href="/heating-oil-delivery/?state=${page.area().id()}">Selected suppliers in ${page.area().name()} ↗</a>@else<a href="/heating-oil-delivery/">View selected Northeast suppliers ↗</a>@endif</p>
</div></section>
<section class="v2-shell fuel-section" id="state-prices"><div class="fuel-section-head"><div><p class="v2-eyebrow">Same survey · same observation date</p><h2>Heating oil prices by state</h2></div><p>All prices below were observed ${page.snapshot().observedOn().toString()} and exclude taxes. A state average is not a live local quote.</p></div>
    <div class="table-wrap"><table><caption>EIA residential heating-oil price and change from the previous observation</caption><thead><tr><th>State</th><th>$/gallon</th><th>Change</th></tr></thead><tbody>@for (var row : page.states())<tr><th scope="row">@if (!row.path().isBlank())<a href="${row.path()}">${row.area().name()}</a>@else${row.area().name()}@endif</th><td>$${row.price()}</td><td>${row.changeLabel()}</td></tr>@endfor</tbody></table></div>
</section>
<section class="fuel-soft" id="quote-check"><div class="v2-shell fuel-section fuel-two-column"><div><p class="v2-eyebrow">Before placing an order</p><h2>Compare the delivered total.</h2><p>${page.area().sourceNote()}</p><ol><li>Use the same fuel grade and gallon quantity for both quotes.</li><li>Ask about cash/card prices, minimum gallons, tax, delivery fees and service contracts.</li><li>Confirm that the supplier serves your address and can meet your requested date.</li></ol><a class="v2-button" href="/heating-oil-cost-calculator/">Compare two complete quotes ↗</a></div><div class="fuel-notes"><h3>Why does my local quote differ?</h3><p>The survey combines residential observations. Order size, delivery area, payment method and service terms can change your quote. A lower-than-average quote is not automatically better, and a higher quote is not proof of overcharging.</p><h3>Is this today's price?</h3><p>This page shows a dated weekly benchmark. Ask your supplier for a current quote. Updates are checked periodically; the observation and release dates remain visible even when a source is unavailable.</p><h3>How long will the oil last?</h3><p>Use your own consumption history to estimate days remaining, then leave a reserve for delivery timing.</p><a href="/heating-oil-usage-calculator/">Calculate days remaining ↗</a></div></div></section>
<section class="v2-shell fuel-section fuel-source"><h2>Plan the purchase</h2><p><a href="/100-gallons-heating-oil/">100-gallon cost and days</a> · <a href="/150-gallons-heating-oil/">150-gallon order comparison</a> · <a href="/cash-heating-oil/">Cash and COD terms</a> · <a href="/fixed-vs-capped-heating-oil-prices/">Fixed vs. capped plans</a> · <a href="/heating-oil-guides/">All buying guides</a></p><h2>Official source material</h2><p><a href="${page.snapshot().sourceUrl()}" rel="external">EIA residential heating-oil price table ↗</a> · <a href="https://www.eia.gov/petroleum/heatingoilpropane/" rel="external">Publication schedule and methodology ↗</a></p><p>Prices are US dollars per US gallon, excluding taxes. Previous observations may be revised by EIA. History here starts ${page.history().get(0).date().toString()}; it is not represented as a complete historical series.</p>
@if (page.area().id().equals("new-york"))<p><a href="https://www.nyserda.ny.gov/energy-prices/home-heating-oil/average-home-heating-oil-prices" rel="external">NYSERDA regional credit-price survey ↗</a> offers a different comparison basis. Its figures are not blended into this EIA series.</p>@endif
<p>Buying or selling a property with unclear tank history? <a href="/#start-check">Start a property record check</a> for optional NJ/NY assistance.</p></section>
</div>
`)
